---
import BaseLayout from "./BaseLayout.astro";

// ─── Themed wrapper for individual tool pages ────────────────────────
// Provides the hero, optional Tips strip, "Explore More Tools" row,
// and bottom CTA. The actual calculator/widget goes in the default
// slot (currently a React island like <SleepTracker client:load />).
//
// Each tool picks its own pastel theme via the `theme` prop so the
// row of tool pages reads as a palette but stays cohesive.

interface Tip {
  title: string;
  desc: string;
  icon?: "bulb" | "moon" | "heart" | "star" | "leaf";
}

interface Props {
  title:       string;
  description: string;
  toolName:    string;
  /** Free-text below the title, e.g. "Track naps, nighttime sleep, and build better sleep habits". */
  toolTagline?: string;
  /** Icon used in the hero badge — pick from the inline SVG set below. */
  icon?: "moon" | "bottle" | "ruler" | "blocks" | "feet" | "heart" | "chart" | "timer" | "clipboard" | "star";
  /** Card / badge / button colour theme (pastel bg + saturated fg). */
  theme?: "blue" | "green" | "yellow" | "purple" | "pink" | "brown";
  /** Optional placeholder for the hero photo on the right. */
  heroImage?: string;
  heroImageAlt?: string;
  /** Optional "Tips for You" cards below the calculator. */
  tipsHeading?: string;
  tips?: Tip[];
}

const {
  title,
  description,
  toolName,
  toolTagline = "",
  icon = "star",
  theme = "blue",
  heroImage = "",
  heroImageAlt = "",
  tipsHeading = `Tips for You`,
  tips = [],
} = Astro.props as Props;

const THEMES = {
  blue:   { bg: "#E6F0FB", fg: "#5B9BD5", fgDark: "#2E6FB8", btnBg: "#5B9BD5", btnHover: "#2E6FB8" },
  green:  { bg: "#DDF0E5", fg: "#7BC0A0", fgDark: "#3E8A66", btnBg: "#7BC0A0", btnHover: "#3E8A66" },
  yellow: { bg: "#FBEED5", fg: "#E8B86E", fgDark: "#A37224", btnBg: "#E8B86E", btnHover: "#A37224" },
  purple: { bg: "#E4DEF0", fg: "#A89BD4", fgDark: "#6C5BA1", btnBg: "#A89BD4", btnHover: "#6C5BA1" },
  pink:   { bg: "#FBE0E6", fg: "#E89BAE", fgDark: "#B05B73", btnBg: "#E89BAE", btnHover: "#B05B73" },
  brown:  { bg: "#F1E2D3", fg: "#B68C73", fgDark: "#80573D", btnBg: "#B68C73", btnHover: "#80573D" },
};
const T = THEMES[theme];

// ─── Cross-link strip: 5 other tools ─────────────────────────────────
// Listed once here so every individual tool page surfaces siblings.
const allTools = [
  { slug: "sleep-tracker",     label: "Sleep Tracker",     icon: "moon",   theme: THEMES.blue   },
  { slug: "feeding-timer",     label: "Feeding Timer",     icon: "bottle", theme: THEMES.green  },
  { slug: "growth-calculator", label: "Growth Calculator", icon: "ruler",  theme: THEMES.yellow },
  { slug: "name-generator",    label: "Name Generator",    icon: "blocks", theme: THEMES.purple },
  { slug: "milestone-checker", label: "Milestone Tracker", icon: "feet",   theme: THEMES.blue   },
  { slug: "bottle-calculator", label: "Bottle Calculator", icon: "bottle", theme: THEMES.green  },
  { slug: "tummy-time",        label: "Tummy Time",        icon: "timer",  theme: THEMES.pink   },
  { slug: "white-noise",       label: "White Noise",       icon: "moon",   theme: THEMES.blue   },
];

// Current tool slug — used to filter it out of the strip.
const currentSlug = Astro.url.pathname.replace(/^\/tools\//, "").replace(/\/$/, "");
const relatedTools = allTools.filter((t) => t.slug !== currentSlug).slice(0, 5);
---

<BaseLayout title={title} description={description}>
  <!-- ───────── HERO ───────── -->
  <section class="relative bg-gradient-to-b from-[#F1F7FD] to-[#E6F0FB] overflow-hidden">
    <div class="max-w-7xl mx-auto px-5 pt-10 md:pt-14 pb-12 md:pb-16 grid lg:grid-cols-[1.05fr_1fr] gap-10 items-center">
      <div>
        <nav class="text-xs text-[#6B7B91] mb-5" aria-label="Breadcrumb">
          <ol class="flex items-center gap-1.5 list-none m-0 p-0">
            <li><a href="/" class="hover:text-[#2E6FB8] no-underline">Home</a></li>
            <li aria-hidden="true">›</li>
            <li><a href="/tools/" class="hover:text-[#2E6FB8] no-underline">Tools</a></li>
            <li aria-hidden="true">›</li>
            <li class="text-[#1E3A5F]">{toolName}</li>
          </ol>
        </nav>
        <div class="flex items-start gap-4 mb-4">
          <span class="inline-flex items-center justify-center w-16 h-16 rounded-2xl shrink-0" style={`background:${T.bg}; color:${T.fg};`} aria-hidden="true">
            {icon === "moon"      && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/><circle cx="16" cy="6" r="1" fill="currentColor"/><circle cx="20" cy="10" r="0.7" fill="currentColor"/></svg>}
            {icon === "bottle"    && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="9" width="8" height="13" rx="2"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/><path d="M10 4h4"/><path d="M9 14h6"/></svg>}
            {icon === "ruler"     && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="3" width="4" height="18" rx="1"/><path d="M6 7h2M6 11h2M6 15h2M6 19h2"/></svg>}
            {icon === "blocks"    && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/><rect x="8" y="3" width="8" height="8" rx="1"/></svg>}
            {icon === "feet"      && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="8" cy="11" rx="3" ry="4"/><ellipse cx="17" cy="15" rx="3" ry="4"/></svg>}
            {icon === "heart"     && <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9C.8 8.8 2.6 5 6.2 5c2 0 3.4 1.1 4.3 2.5C11.4 6.1 12.8 5 14.8 5c3.6 0 5.4 3.8 3.7 7C19 16.5 12 21 12 21z"/></svg>}
            {icon === "chart"     && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21v-7m6 7V10m6 11v-5m6 5V4"/></svg>}
            {icon === "timer"     && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M10 1h4"/></svg>}
            {icon === "clipboard" && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 3h6v3H9z"/></svg>}
            {icon === "star"      && <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15 9 22 9.5 17 14.5 18.5 22 12 18 5.5 22 7 14.5 2 9.5 9 9 12 2"/></svg>}
          </span>
          <div>
            <h1 class="font-display text-[#1E3A5F] leading-[1.1] text-3xl md:text-4xl lg:text-5xl m-0">{toolName}</h1>
            {toolTagline && <p class="text-[#5A6F89] text-sm md:text-base mt-2 leading-relaxed">{toolTagline}</p>}
          </div>
        </div>
        <div class="flex flex-wrap gap-2 mt-5">
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-white text-[#2E6FB8] px-3 py-1.5 rounded-full">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>
            Easy to Use
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-white text-[#2E6FB8] px-3 py-1.5 rounded-full">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2 4 6v6c0 5 4 9 8 10 4-1 8-5 8-10V6l-8-4z"/></svg>
            Private &amp; Secure
          </span>
        </div>
      </div>
      <div class="relative">
        {heroImage ? (
          <img src={heroImage} alt={heroImageAlt} class="w-full aspect-[4/3] rounded-3xl object-cover shadow-md" loading="eager" />
        ) : (
          <div class="aspect-[4/3] rounded-3xl bg-gradient-to-br from-[#E6F0FB] via-[#F0E6FB] to-[#FBF0E6] shadow-md flex items-center justify-center text-[#6B7B91] text-sm">
            <span class="opacity-50">{toolName} hero photo</span>
          </div>
        )}
        <span class="absolute -top-2 left-6 text-2xl opacity-70" aria-hidden="true">⭐</span>
        <span class="absolute top-3 -right-2 text-2xl opacity-70" aria-hidden="true">☁️</span>
      </div>
    </div>
    <svg class="block w-full text-white" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,30 C360,60 720,0 1080,30 C1260,45 1380,15 1440,30 L1440,60 L0,60 Z" fill="currentColor"/>
    </svg>
  </section>

  <!-- ───────── TOOL WIDGET (consumer-supplied) ───────── -->
  <section class="max-w-5xl mx-auto px-5 py-10">
    <slot />
  </section>

  <!-- ───────── TIPS FOR YOU ───────── -->
  {tips.length > 0 && (
    <section class="max-w-7xl mx-auto px-5 py-8">
      <div class="text-center mb-7">
        <h2 class="font-display text-xl md:text-2xl text-[#1E3A5F] m-0">{tipsHeading}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {tips.map((tip) => (
          <div class="bg-white rounded-2xl p-5 shadow-sm hover:shadow-md transition-shadow">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-full mb-3" style={`background:${T.bg}; color:${T.fg};`} aria-hidden="true">
              {(tip.icon ?? "bulb") === "bulb"  && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"/></svg>}
              {tip.icon === "moon"  && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>}
              {tip.icon === "heart" && <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9C.8 8.8 2.6 5 6.2 5c2 0 3.4 1.1 4.3 2.5C11.4 6.1 12.8 5 14.8 5c3.6 0 5.4 3.8 3.7 7C19 16.5 12 21 12 21z"/></svg>}
              {tip.icon === "star"  && <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15 9 22 9.5 17 14.5 18.5 22 12 18 5.5 22 7 14.5 2 9.5 9 9 12 2"/></svg>}
              {tip.icon === "leaf"  && <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-3.34C7 19 8.5 19 11 18c5-2 7-7 6-10z"/></svg>}
            </span>
            <h3 class="font-bold text-sm text-[#1E3A5F] mb-1.5">{tip.title}</h3>
            <p class="text-xs text-[#6B7B91] leading-relaxed">{tip.desc}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ───────── EXPLORE MORE HELPFUL TOOLS ───────── -->
  <section class="max-w-7xl mx-auto px-5 py-10">
    <div class="text-center mb-7">
      <h2 class="font-display text-xl md:text-2xl text-[#1E3A5F] m-0">Explore More Helpful Tools</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {relatedTools.map((r) => (
        <a href={`/tools/${r.slug}/`} class="group flex flex-col items-center text-center bg-white rounded-2xl p-4 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all no-underline">
          <span class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-2" style={`background:${r.theme.bg}; color:${r.theme.fg};`} aria-hidden="true">
            {r.icon === "moon"   && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>}
            {r.icon === "bottle" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="8" y="9" width="8" height="13" rx="2"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>}
            {r.icon === "ruler"  && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="6" y="3" width="4" height="18" rx="1"/></svg>}
            {r.icon === "blocks" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/><rect x="8" y="3" width="8" height="8" rx="1"/></svg>}
            {r.icon === "feet"   && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><ellipse cx="8" cy="11" rx="3" ry="4"/><ellipse cx="17" cy="15" rx="3" ry="4"/></svg>}
            {r.icon === "timer"  && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/></svg>}
          </span>
          <h3 class="text-xs font-bold text-[#1E3A5F] group-hover:text-[#2E6FB8] transition-colors leading-snug">{r.label}</h3>
        </a>
      ))}
    </div>
  </section>

  <!-- ───────── BOTTOM CTA STRIP ───────── -->
  <section class="max-w-7xl mx-auto px-5 pb-16">
    <div class="bg-[#E6F0FB] rounded-3xl py-6 px-6 md:px-8 flex flex-col md:flex-row items-center gap-5">
      <span class="text-4xl" aria-hidden="true">🧸</span>
      <div class="flex-1 text-center md:text-left">
        <h3 class="font-display font-bold text-[#1E3A5F] text-lg">Track, understand, and support your baby's journey.</h3>
        <p class="text-sm text-[#6B7B91]">All our tools are free and always will be.</p>
      </div>
      <a href="/tools/" class="inline-flex items-center gap-2 bg-[#5B9BD5] hover:bg-[#2E6FB8] text-white text-sm font-semibold px-6 py-3 rounded-full no-underline whitespace-nowrap transition-colors">
        Explore Tools <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
