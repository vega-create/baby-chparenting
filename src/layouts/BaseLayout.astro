---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../../site.config";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article";
  publishDate?: string;
  author?: string;
  /** Set to true on pages that inline their own footer onto an
      image (e.g. the home Mission section). Defaults to false. */
  hideFooter?: boolean;
}

const { title, description, image, canonical, type, publishDate, author, hideFooter = false } =
  Astro.props;

const ga4Id: string = siteConfig.analytics.ga4 || "";
const pixelId: string = siteConfig.analytics.metaPixel || "";

const ga4Script =
  "window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','" +
  ga4Id +
  "');";

const pixelScript =
  "!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','" +
  pixelId +
  "');fbq('track','PageView');";

const pixelNoscript =
  '<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=' +
  pixelId +
  '&ev=PageView&noscript=1" />';

// Organization Schema — appears on every page, tells Google + AI crawlers that
// a real company (not a personal blog) operates this site. Boosts E-E-A-T for
// YMYL (Your Money or Your Life) topics like baby health and pregnancy.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteConfig.url}#organization`,
  name: siteConfig.name,
  legalName: "Mommy Wisdom International LTD. 智慧媽咪國際有限公司",
  url: siteConfig.url,
  logo: {
    "@type": "ImageObject",
    url: `${siteConfig.url}/favicon.svg`,
    width: 512,
    height: 512,
  },
  founder: {
    "@type": "Person",
    name: "Vega Lin (薇佳)",
    jobTitle: "Founder",
    url: "https://chparenting.com/about/",
    alumniOf: { "@type": "EducationalOrganization", name: "Tunghai University" },
  },
  parentOrganization: {
    "@type": "Organization",
    name: "媽媽生活復原力Lab",
    url: "https://chparenting.com",
  },
  sameAs: [
    "https://chparenting.com",
    "https://pregnancy.chparenting.com",
    "https://learn.chparenting.com",
    "https://english.chparenting.com",
    "https://kids.chparenting.com",
    "https://mommystartup.com",
    "https://mommywisdom.tw",
    "https://aimommywisdom.com",
    "https://vega-note.com",
  ],
  knowsAbout: [
    "infant care",
    "baby sleep training",
    "breastfeeding and formula feeding",
    "pregnancy week-by-week",
    "prenatal nutrition",
    "child development",
    "evidence-based parenting",
  ],
};
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
  {/*
    EzoicAds JavaScript Integration — must sit at the very top of <head>.
    Order matters: privacy CMP scripts (data-cfasync="false") MUST load
    BEFORE the header script so Cloudflare/Rocket-Loader doesn't reorder
    them. Docs: https://docs.ezoic.com/docs/ezoicads/integration/
  */}
  <script is:inline data-cfasync="false" src="https://cmp.gatekeeperconsent.com/min.js"></script>
  <script is:inline data-cfasync="false" src="https://the.gatekeeperconsent.com/cmp.min.js"></script>
  <script is:inline async src="//www.ezojs.com/ezoic/sa.min.js"></script>
  <script is:inline>
    window.ezstandalone = window.ezstandalone || {};
    window.ezstandalone.cmd = window.ezstandalone.cmd || [];
  </script>
  <script is:inline src="//ezoicanalytics.com/analytics.js"></script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#3B82F6" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      type={type}
      publishDate={publishDate}
      author={author}
    />
    {ga4Id && <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />}
    {ga4Id && <script is:inline set:html={ga4Script} />}
    {pixelId && <script is:inline set:html={pixelScript} />}
    {pixelId && <noscript set:html={pixelNoscript} />}
    {
      siteConfig.adsense.enabled && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsense.client}`}
          crossorigin="anonymous"
        />
      )
    }
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>
