---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import TableOfContents from "../components/TableOfContents.astro";
import AuthorBox from "../components/AuthorBox.astro";
import PregnancySiteCTA from "../components/PregnancySiteCTA.astro";
import EditorialNotice from "../components/EditorialNotice.astro";
import ArticleByline from "../components/ArticleByline.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
import AdSense from "../components/AdSense.astro";
import { siteConfig } from "../../site.config";

interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  lastReviewed?: Date;
  category?: string;
  tags?: string[];
  author?: string;
  authorUrl?: string;
  image?: string;
  imageCredit?: string;
  headings: { depth: number; slug: string; text: string }[];
  slug: string;
}

const {
  title,
  description,
  publishDate,
  lastReviewed,
  category,
  tags = [],
  author = "Vega Lin",
  authorUrl = "/author/vega-lin/",
  image,
  imageCredit,
  headings,
  slug,
} = Astro.props;

const categoryLabels: Record<string, string> = {
  sleep: "Sleep",
  names: "Names",
  feeding: "Feeding",
  gear: "Gear",
  development: "Development",
};

const canonicalUrl = `https://baby.chparenting.com/blog/${slug}/`;

// Article JSON-LD for E-E-A-T
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description,
  image: image ? [image] : undefined,
  datePublished: publishDate.toISOString(),
  dateModified: (lastReviewed || publishDate).toISOString(),
  author: {
    "@type": "Person",
    name: author,
    url: `https://baby.chparenting.com${authorUrl}`,
  },
  publisher: {
    "@type": "Organization",
    name: "Baby Care Guide",
    logo: {
      "@type": "ImageObject",
      url: "https://baby.chparenting.com/favicon.svg",
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishDate={publishDate.toISOString()}
  author={author}
  canonical={canonicalUrl}
>
  <article class="max-w-6xl mx-auto px-4 py-10">
    <Breadcrumb
      items={[
        { label: "Home", href: "/" },
        { label: "Blog", href: "/blog/" },
        ...(category
          ? [
              {
                label: categoryLabels[category] ?? category,
                href: `/blog/?category=${category}`,
              },
            ]
          : []),
        { label: title },
      ]}
    />

    <header class="mb-8 max-w-3xl">
      {
        category && (
          <span class="inline-block text-xs font-semibold uppercase tracking-wide text-[#1D4ED8] bg-blue-50 px-3 py-1 rounded-full mb-4">
            {categoryLabels[category] ?? category}
          </span>
        )
      }
      {
        image && (
          <figure class="mb-6">
            <img
              src={image}
              alt={title}
              class="w-full rounded-2xl max-h-[400px] object-cover object-[50%_25%]"
              loading="eager"
            />
            {imageCredit && (
              <figcaption class="mt-2 text-xs text-[#9CA3AF] italic">
                Photo: {imageCredit}
              </figcaption>
            )}
          </figure>
        )
      }
      <h1 class="mb-4">{title}</h1>
      <ArticleByline
        author={author}
        authorUrl={authorUrl}
        publishDate={publishDate}
        lastReviewed={lastReviewed}
        tags={tags}
      />
    </header>

    <div class="lg:grid lg:grid-cols-[1fr_250px] lg:gap-12">
      <div class="article-content">
        <EditorialNotice />

        {/* 廣告：文章開頭（2026-10-22 起。這站每千次廣告曝光的收益比 learn 高，但之前文章頁一個廣告都沒放） */}
        <AdSense slot="top" />

        <slot />

        <div
          class="mt-12 p-4 bg-amber-50 border-l-4 border-amber-300 rounded-r-xl text-sm text-[#1E293B] italic"
        >
          <strong>Medical Disclaimer:</strong> This article is for informational
          purposes only and is not a substitute for professional medical advice,
          diagnosis, or treatment. Always consult your pediatrician or
          healthcare provider with any questions about your baby's health.
        </div>

        {/* 廣告：文章結尾（捲到附近才載入，見下方 script） */}
        <div class="adsense-container my-8" data-ad-lazy="8916289459"></div>

        <AuthorBox name={author} url={authorUrl} />

        <RelatedArticles category={category} currentSlug={slug} limit={3} />

        <PregnancySiteCTA />
      </div>

      <aside class="hidden lg:block">
        <TableOfContents headings={headings} />
        {/* 廣告：電腦版側欄（300×600，跟著捲動） */}
        <AdSense slot="sidebar" />
      </aside>
    </div>

    <div class="lg:hidden -mt-6 mb-6">
      <TableOfContents headings={headings} />
    </div>
  </article>

  {/* 廣告：文章中段與結尾。
      AdSense 對一開始就在畫面外的廣告框，會標成處理完但從來不去要廣告（2026-10-22 在 Chrome 實測：
      開頭與側欄有填、中段與結尾永遠空白）。所以中段、結尾改成「進入畫面時才建立廣告框並送出」（實測進入畫面才送才會填，提早送也不會）。中段放在第 2 個 H2 前面（文章至少要有 3 個 H2 才放）。
      沒填到廣告的框用 CSS 收起來，不留空白。 */}
  {siteConfig.adsense.enabled && (
    <>
      <style is:inline>{`ins.adsbygoogle[data-ad-status="unfilled"]{display:none!important}`}</style>
      <script is:inline define:vars={{ client: siteConfig.adsense.client, midSlot: "1271948163" }}>
        (function () {
          var h2s = document.querySelectorAll(".article-content h2");
          if (h2s.length >= 3) {
            var mid = document.createElement("div");
            mid.className = "adsense-container my-8";
            mid.setAttribute("data-ad-lazy", midSlot);
            h2s[1].parentNode.insertBefore(mid, h2s[1]);
          }
          function load(box) {
            if (box.getAttribute("data-ad-loaded")) return;
            box.setAttribute("data-ad-loaded", "1");
            var ins = document.createElement("ins");
            ins.className = "adsbygoogle";
            ins.style.display = "block";
            ins.setAttribute("data-ad-client", client);
            ins.setAttribute("data-ad-slot", box.getAttribute("data-ad-lazy"));
            ins.setAttribute("data-ad-format", "auto");
            ins.setAttribute("data-full-width-responsive", "true");
            box.appendChild(ins);
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          }
          var boxes = document.querySelectorAll("[data-ad-lazy]");
          if (!("IntersectionObserver" in window)) { boxes.forEach(load); return; }
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) { if (en.isIntersecting) { io.unobserve(en.target); load(en.target); } });
          }, { rootMargin: "0px" });   // 實測：廣告框要「已經在畫面內」才 push，AdSense 才會真的去要廣告；提早 150px 都不行
          boxes.forEach(function (b) { io.observe(b); });
        })();
      </script>
    </>
  )}

  <script
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
    is:inline
  />
</BaseLayout>
