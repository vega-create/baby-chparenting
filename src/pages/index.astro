---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../../site.config";
import { getCollection } from "astro:content";

// Latest 4 published posts for the homepage feed.
const now = new Date();
const latestPosts = (await getCollection("blog", ({ data }) => !data.draft && data.publishDate <= now))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 4);

// 4 promise pills — sit overlapping the hero bottom.
const promises = [
  { color: "#5B9BD5", bg: "#E6F0FB", title: "Sleep",       desc: "Better sleep for baby & you",       icon: "moon"   },
  { color: "#7BC0A0", bg: "#DDF0E5", title: "Feeding",     desc: "From breast to baby's first bites", icon: "bottle" },
  { color: "#E8B86E", bg: "#FBEED5", title: "Growth",      desc: "Track growth and milestones",        icon: "chart"  },
  { color: "#A89BD4", bg: "#E4DEF0", title: "Development", desc: "Nurture skills every step of the way", icon: "sprout" },
];

// 4 main guides — link to existing category pages.
const guides = [
  { title: "Sleep Guide",       href: "/sleep/",       image: "/images/hero/guide-sleep.jpg",       alt: "Sleeping baby in a blue onesie against a navy nursery wall painted with moon and stars",                       lines: "Schedules, routines<br/>& sleep tips" },
  { title: "Feeding Guide",     href: "/feeding/",     image: "/images/hero/guide-feeding.jpg",     alt: "Sage-green bottle and bowl of orange baby food puree with banana slices and small cubes on a soft pastel table",  lines: "Breastfeeding, formula<br/>& baby foods" },
  { title: "Development Guide", href: "/development/", image: "/images/hero/guide-development.jpg", alt: "Soft pastel rainbow stacker, teddy bear, wooden abacus, and shape sorter blocks in a bright nursery",          lines: "Milestones, activities<br/>& play ideas" },
  { title: "Gear Guide",        href: "/gear/",        image: "/images/hero/guide-gear.jpg",        alt: "Lavender vintage bassinet stroller surrounded by baby gear — bottle, wooden toys, and a small teddy in a basket", lines: "Reviews & recommendations<br/>for baby essentials" },
];

// 5 free tools shown in the homepage strip.
const tools = [
  { title: "Sleep Tracker",     href: "/tools/sleep-tracker/",     icon: "moon",   sub: "Track naps and<br/>nighttime sleep" },
  { title: "Feeding Timer",     href: "/tools/feeding-timer/",     icon: "bottle", sub: "Track feeds and<br/>daily intake" },
  { title: "Growth Tracker",    href: "/tools/growth-tracker/",    icon: "chart",  sub: "Monitor growth<br/>percentiles" },
  { title: "Milestone Tracker", href: "/tools/milestone-tracker/", icon: "feet",   sub: "Track developmental<br/>milestones" },
  { title: "Name Generator",    href: "/names/",                   icon: "star",   sub: "Discover the perfect<br/>baby name" },
];

const trustPills = [
  { color: "#5B9BD5", title: "Expert-Reviewed", desc: "All content is reviewed by health professionals." },
  { color: "#E89BAE", title: "Parent-Focused",  desc: "Real-life advice for real parenting journeys." },
  { color: "#A89BD4", title: "Here for You",    desc: "Support and encouragement every step of the way." },
];
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.shortTagline}`}
  description={siteConfig.description}
  hideFooter
>
  <!-- ───────── HERO ─────────
       Mobile (<lg): inline cropped image with title overlay on its
                     left half; description + CTA stack BELOW.
       Desktop (lg+): photo as a section-filling background via the
                     <picture>; full text content overlays on the
                     left of the photo. object-position 50%_25%
                     biases the crop slightly upward so the baby's
                     face stays in frame (some of the bottom pills
                     get cropped — they're decorative, not
                     navigation). -->
  <section class="relative overflow-hidden bg-gradient-to-b from-[#F1F7FD] to-[#E6F0FB] lg:min-h-[640px] xl:min-h-[720px]">
    <picture class="lg:absolute lg:inset-0 lg:block lg:h-full lg:w-full">
      <source media="(min-width: 1024px)" srcset="/images/hero/baby-home-banner.jpg" />
      <img
        src="/images/hero/baby-home-banner-mobile.jpg"
        alt="Smiling baby in a blue onesie holding a teddy bear on a soft bed surrounded by pastel star and footprint decorations"
        class="block w-full h-auto lg:h-full lg:w-full lg:object-cover lg:object-[50%_25%]"
        width="2000"
        height="1143"
        loading="eager"
        fetchpriority="high"
      />
    </picture>

    <!-- MOBILE-ONLY title overlay: eyebrow + H1 on the left of the photo -->
    <div class="lg:hidden absolute top-0 left-0 right-1/2 h-[60%] flex flex-col justify-center px-5 z-10">
      <span class="inline-flex w-fit items-center gap-1.5 text-[10px] font-semibold text-[#2E6FB8] bg-white/90 px-2.5 py-1 rounded-full mb-3 shadow-sm">
        <span aria-hidden="true">♡</span> {siteConfig.tagline}
      </span>
      <h1 class="font-display text-[#1E3A5F] leading-[1.1] text-2xl sm:text-3xl">
        Complete<br/>Baby Care<br/>Guide
      </h1>
    </div>

    <!-- DESKTOP-ONLY full text overlay over the photo's left zone -->
    <div class="hidden lg:flex absolute inset-0 max-w-7xl mx-auto px-5 items-center z-10">
      <div class="max-w-xl">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#2E6FB8] bg-white/90 px-3 py-1.5 rounded-full mb-5 shadow-sm">
          <span aria-hidden="true">♡</span> {siteConfig.tagline}
        </span>
        <h1 class="font-display text-[#1E3A5F] leading-[1.1] mb-5 text-5xl xl:text-6xl">
          Complete<br/>Baby Care Guide
        </h1>
        <p class="text-[#3F5575] text-lg leading-relaxed max-w-md mb-6">
          Evidence-based support for sleep, feeding, development, and everyday parenting.
        </p>
        <a href="#guides" class="inline-flex items-center gap-2 bg-[#5B9BD5] hover:bg-[#2E6FB8] text-white font-semibold px-6 py-3 rounded-full no-underline transition-colors shadow-md">
          Explore Guides <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- MOBILE-ONLY description + CTA below the photo -->
    <div class="lg:hidden max-w-7xl mx-auto px-5 py-8">
      <div class="max-w-xl">
        <p class="text-[#3F5575] text-sm leading-relaxed max-w-md mb-5">
          Evidence-based support for sleep, feeding, development, and everyday parenting.
        </p>
        <a href="#guides" class="inline-flex items-center gap-2 bg-[#5B9BD5] hover:bg-[#2E6FB8] text-white font-semibold px-6 py-3 rounded-full no-underline transition-colors shadow-md">
          Explore Guides <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <!-- Wave bridges hero photo into the body bg below — restores the
         soft transition between the photographed pills and the next
         section that user noticed disappeared. -->
    <svg class="block w-full text-[#F8FAFC] -mb-px absolute bottom-0 left-0 right-0 z-10" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,30 C360,60 720,0 1080,30 C1260,45 1380,15 1440,30 L1440,60 L0,60 Z" fill="currentColor"/>
    </svg>
  </section>

  <!-- ───────── 4 MAIN GUIDES ───────── -->
  <section id="guides" class="max-w-7xl mx-auto px-5 pt-16 pb-12">
    <div class="text-center mb-10">
      <h2 class="font-display text-2xl md:text-3xl text-[#1E3A5F] mb-2">Everything You Need in One Place</h2>
      <p class="text-[#6B7B91]">Expert guides, practical tools, and real support for every stage.</p>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
      {guides.map((g) => (
        <a href={g.href} class="group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow no-underline">
          <img
            src={g.image}
            alt={g.alt}
            class="w-full aspect-[4/3] object-cover object-center"
            width="800"
            height="600"
            loading="lazy"
          />
          <div class="p-5">
            <h3 class="font-display text-lg font-bold text-[#1E3A5F] mb-2 group-hover:text-[#2E6FB8] transition-colors">{g.title}</h3>
            <p class="text-sm text-[#6B7B91] leading-snug mb-3" set:html={g.lines}></p>
            <span class="text-sm font-semibold text-[#5B9BD5] inline-flex items-center gap-1">Explore <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ───────── HELPFUL TOOLS ───────── -->
  <!-- Two background images: a desktop layer (size 100% 100% so corner
       footprints stay visible at the wide aspect) and a mobile layer
       (background-size: cover so footprints aren't vertically stretched
       on narrow viewports). Only one is active at a time. -->
  <section class="relative py-16 px-5 bg-[#E6F0FB] tools-bg">
    <div class="max-w-7xl mx-auto relative">
      <div class="text-center mb-10">
        <span class="inline-block text-xs font-semibold text-[#2E6FB8] bg-white px-3 py-1 rounded-full mb-3 tracking-wider">FREE PARENTING TOOLS</span>
        <h2 class="font-display text-2xl md:text-3xl text-[#1E3A5F] mb-2">Helpful Tools for Busy Parents</h2>
        <p class="text-[#6B7B91]">Track, manage, and celebrate your baby's growth with our free tools.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {tools.map((t) => (
          <a href={t.href} class="block bg-white rounded-2xl p-5 text-center no-underline shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
            <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-[#E6F0FB] text-[#2E6FB8] mb-3" aria-hidden="true">
              {t.icon === "moon"   && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>}
              {t.icon === "bottle" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="8" y="9" width="8" height="13" rx="2"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>}
              {t.icon === "chart"  && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 21v-7m6 7V10m6 11v-5m6 5V4"/></svg>}
              {t.icon === "feet"   && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="7" cy="9" r="2"/><circle cx="11" cy="6" r="1.5"/><circle cx="14" cy="6" r="1.5"/><circle cx="6" cy="14" r="2"/><circle cx="10" cy="17" r="1.5"/></svg>}
              {t.icon === "star"   && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><polygon points="12 2 15 9 22 9.5 17 14.5 18.5 22 12 18 5.5 22 7 14.5 2 9.5 9 9 12 2"/></svg>}
            </span>
            <h3 class="text-[15px] font-bold text-[#1E3A5F] mb-1">{t.title}</h3>
            <p class="text-xs text-[#6B7B91] leading-relaxed" set:html={t.sub}></p>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/tools/" class="inline-flex items-center gap-2 bg-[#5B9BD5] hover:bg-[#2E6FB8] text-white font-semibold px-6 py-3 rounded-full no-underline transition-colors">
          View All Tools <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ───────── LATEST BLOG ───────── -->
  <section class="max-w-7xl mx-auto px-5 py-16">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-8">
      <h2 class="font-display text-2xl md:text-3xl text-[#1E3A5F] m-0">Latest from the Blog</h2>
      <a href="/blog/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#2E6FB8] no-underline border border-[#5B9BD5] hover:bg-[#5B9BD5] hover:text-white px-4 py-1.5 rounded-full transition-colors">
        View All Articles <span aria-hidden="true">→</span>
      </a>
    </div>
    {latestPosts.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {latestPosts.map((p) => (
          <a href={`/blog/${p.data.slug || p.slug}/`} class="block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow no-underline">
            {p.data.image ? (
              <img src={p.data.image} alt={p.data.title} class="w-full h-44 object-cover object-[50%_25%]" loading="lazy" />
            ) : (
              <div class="w-full h-44 bg-gradient-to-br from-[#E6F0FB] to-[#FBE6EE]"></div>
            )}
            <div class="p-5">
              {p.data.category && (
                <span class="inline-block text-[11px] font-semibold uppercase tracking-wide text-[#2E6FB8] bg-[#E6F0FB] px-2.5 py-1 rounded-full mb-2.5">{p.data.category}</span>
              )}
              <span class="text-[11px] text-[#6B7B91] ml-2">{new Date(p.data.publishDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
              <h3 class="font-display text-[15px] font-bold text-[#1E3A5F] mb-2 mt-1 leading-snug line-clamp-2">{p.data.title}</h3>
              <p class="text-xs text-[#6B7B91] leading-relaxed line-clamp-2">{p.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-center text-[#6B7B91]">Fresh articles coming soon.</p>
    )}
  </section>

  <!-- ───────── MISSION + FOOTER (responsive banner) ─────────
       Desktop (lg+): supplied photo is the bg of a single section.
                      Mission text overlays the upper cream zone;
                      footer copy overlays the lower blue band next
                      to the bear.
       Mobile (<lg):  DOM order — Mission (cream block) → image →
                      Footer (blue block). Each block stands on its
                      own bg so the colour story stays
                      cream→image→blue with no jumps. -->
  <section class="relative">
    <!-- TOP: Mission text — mobile cream block (no CTA — that lives
         on the image overlay), desktop absolute overlay. -->
    <div class="bg-[#FBF6EF] lg:bg-transparent lg:absolute lg:inset-x-0 lg:top-0 lg:h-[55%] lg:z-10">
      <div class="max-w-7xl mx-auto px-5 py-6 lg:py-0 grid lg:grid-cols-2 gap-6 lg:gap-10 items-center lg:h-full">
        <div class="hidden lg:block" aria-hidden="true"></div>
        <div>
          <span class="text-[11px] sm:text-xs font-semibold text-[#5B9BD5] tracking-wider">OUR MISSION</span>
          <h2 class="font-display text-xl sm:text-2xl md:text-3xl text-[#1E3A5F] mt-1.5 lg:mt-2 mb-2 lg:mb-3 leading-tight">Helping Parents Feel Confident Every Step of the Journey</h2>
          <p class="text-[#5A6F89] leading-relaxed mb-4 lg:mb-5 max-w-lg text-sm md:text-base">
            Baby Care Guide is here to support you with trusted information, practical tools, and a caring community. You don't have to do it alone.
          </p>
          <div class="grid grid-cols-3 gap-3 md:gap-5">
            {trustPills.map((tp) => (
              <div class="text-left">
                <span class="inline-flex items-center justify-center w-8 h-8 md:w-9 md:h-9 rounded-full mb-1.5" style={`background:${tp.color}25; color:${tp.color};`}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C10.3 2 9 3.3 9 5c0 1.7 1.3 3 3 3s3-1.3 3-3-1.3-3-3-3zm0 9c-3 0-9 1.5-9 4.5V21h18v-5.5c0-3-6-4.5-9-4.5z"/></svg>
                </span>
                <h3 class="font-bold text-xs md:text-sm text-[#1E3A5F] mb-0.5">{tp.title}</h3>
                <p class="text-[10px] md:text-xs text-[#6B7B91] leading-relaxed">{tp.desc}</p>
              </div>
            ))}
          </div>
          <!-- Desktop only: Learn More CTA (mobile gets its own overlay-on-image button) -->
          <div class="hidden lg:block mt-4 md:mt-6">
            <a href="/about/" class="inline-flex items-center gap-2 bg-[#5B9BD5] hover:bg-[#2E6FB8] text-white text-sm font-semibold px-5 py-2.5 rounded-full no-underline transition-colors">
              Learn More About Us <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- IMAGE wrapper — relative so the mobile CTA can absolutely
         overlay on the right side of the photo (next to mom). -->
    <div class="relative lg:static">
      <picture>
        <source media="(min-width: 1024px)" srcset="/images/hero/baby-home-mission.jpg" />
        <img
          src="/images/hero/baby-home-mission-mobile.jpg"
          alt="Mother tenderly kissing her baby's forehead, with a teddy bear on a cloud below — cream-and-blue illustrated banner"
          class="block w-full h-auto"
          width="1600"
          height="949"
          loading="lazy"
        />
      </picture>
      <!-- Mobile-only CTA, floats over the photo's right-side cream zone -->
      <a href="/about/" class="lg:hidden absolute top-[18%] right-5 inline-flex items-center gap-1.5 bg-[#5B9BD5] hover:bg-[#2E6FB8] text-white text-xs font-semibold px-4 py-2 rounded-full no-underline transition-colors shadow-md">
        Learn More <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- BOTTOM: Footer content — mobile blue block, desktop absolute overlay.
         lg:h-[36%] keeps the overlay entirely below the cream→blue wave
         (which sits around 58-62% from top), so columns can't bleed into
         the cream zone. -->
    <div class="bg-[#CCDEF2] lg:bg-transparent lg:absolute lg:inset-x-0 lg:bottom-0 lg:h-[36%] lg:z-10">
      <div class="max-w-7xl mx-auto px-5 py-8 lg:py-0 lg:h-full lg:flex lg:flex-col lg:justify-between lg:pb-3 lg:pt-[2%] lg:gap-4">
        <!-- Top row: 4 link columns + a small social cluster, all sitting
             to the right of the bear (lg:pl-[20%] reserves the bear's lane) -->
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-[1fr_1fr_1fr_1fr_auto] gap-5 md:gap-6 lg:pl-[20%]">
          <div>
            <h4 class="banner-col-title">Guides</h4>
            <ul class="banner-col-list">
              {siteConfig.footerColumns.guides.map((it) => <li><a href={it.href} class="banner-col-link">{it.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h4 class="banner-col-title">Tools</h4>
            <ul class="banner-col-list">
              {siteConfig.footerColumns.tools.map((it) => <li><a href={it.href} class="banner-col-link">{it.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h4 class="banner-col-title">Resources</h4>
            <ul class="banner-col-list">
              {siteConfig.footerColumns.resources.map((it) => <li><a href={it.href} class="banner-col-link">{it.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h4 class="banner-col-title">Legal</h4>
            <ul class="banner-col-list">
              {siteConfig.footerColumns.legal.map((it) => <li><a href={it.href} class="banner-col-link">{it.label}</a></li>)}
            </ul>
          </div>
          <!-- Social cluster — vertical column on desktop, full row on mobile -->
          <div class="col-span-2 md:col-span-4 lg:col-span-1 flex lg:flex-col items-start gap-2 lg:gap-2 lg:ml-2">
            <a href={siteConfig.social.facebook}  aria-label="Facebook"  target="_blank" rel="noopener" class="banner-social"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 5.99 4.39 10.96 10.13 11.85v-8.38H7.08v-3.47h3.05V9.43c0-3 1.79-4.67 4.53-4.67 1.31 0 2.69.23 2.69.23v2.96h-1.52c-1.49 0-1.96.93-1.96 1.88v2.24h3.33l-.53 3.47h-2.8v8.38C19.61 23.03 24 18.06 24 12.07z"/></svg></a>
            <a href={siteConfig.social.instagram} aria-label="Instagram" target="_blank" rel="noopener" class="banner-social"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C8.74 0 8.33.01 7.05.07 2.7.27.28 2.69.08 7.05.01 8.33 0 8.74 0 12c0 3.26.01 3.67.07 4.95.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95C23.73 2.69 21.31.27 16.95.07 15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zm0 10.16A4 4 0 1 1 16 12a4 4 0 0 1-4 4z"/></svg></a>
            <a href={siteConfig.social.pinterest} aria-label="Pinterest" target="_blank" rel="noopener" class="banner-social"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.08 3.16 9.42 7.62 11.17-.1-.95-.2-2.4.04-3.44.22-.94 1.41-5.97 1.41-5.97s-.36-.72-.36-1.78c0-1.67.97-2.92 2.17-2.92 1.02 0 1.52.77 1.52 1.69 0 1.03-.66 2.57-1 4-.28 1.19.6 2.17 1.78 2.17 2.13 0 3.77-2.25 3.77-5.5 0-2.87-2.06-4.88-5.01-4.88-3.41 0-5.42 2.56-5.42 5.21 0 1.03.4 2.14.89 2.74.1.12.11.22.08.34l-.33 1.36c-.05.22-.17.27-.4.16-1.5-.7-2.44-2.89-2.44-4.65 0-3.79 2.75-7.26 7.93-7.26 4.17 0 7.4 2.97 7.4 6.93 0 4.14-2.61 7.47-6.23 7.47-1.22 0-2.36-.63-2.75-1.38l-.75 2.85c-.27 1.04-1 2.35-1.49 3.15 1.12.35 2.32.53 3.55.53C18.63 24 24 18.63 24 12 24 5.37 18.63 0 12 0z"/></svg></a>
            <a href={siteConfig.social.youtube}   aria-label="YouTube"   target="_blank" rel="noopener" class="banner-social"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.4 3.5 12 3.5 12 3.5s-7.4 0-9.4.6A3 3 0 0 0 .5 6.2 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c2 .6 9.4.6 9.4.6s7.4 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg></a>
          </div>
        </div>

        <!-- Copyright sits at the very bottom -->
