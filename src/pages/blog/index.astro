---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../../site.config";
import { getCollection } from "astro:content";

// All published posts, newest first.
const now = new Date();
const allPosts = (await getCollection("blog", ({ data }) => !data.draft && data.publishDate <= now))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

// Category counts for the sidebar.
const categoryDefs = [
  { id: "sleep",       label: "Sleep",       color: "#5B9BD5" },
  { id: "feeding",     label: "Feeding",     color: "#7BC0A0" },
  { id: "development", label: "Development", color: "#E8B86E" },
  { id: "parenting",   label: "Parenting",   color: "#A89BD4" },
  { id: "gear",        label: "Gear",        color: "#B68C73" },
  { id: "health",      label: "Health",      color: "#E89BAE" },
  { id: "activities",  label: "Activities",  color: "#7FB6C9" },
];

const counts: Record<string, number> = {};
for (const p of allPosts) {
  const cat = (p.data.category || "uncategorized").toLowerCase();
  counts[cat] = (counts[cat] || 0) + 1;
}

const popularPosts = allPosts.slice(0, 4);

// Category pill colour per slug (default soft blue).
const catColor = (slug: string | undefined) => {
  const c = categoryDefs.find((c) => c.id === (slug || "").toLowerCase());
  return c ? c.color : "#5B9BD5";
};
---

<BaseLayout
  title={`Baby Care Blog — ${siteConfig.name}`}
  description="Expert articles for every stage of your baby's first years. Sleep, feeding, development, parenting tips and more."
>
  <!-- ───────── HERO ─────────
       Desktop (lg+): banner fills section as absolute bg; full text
                     overlay (eyebrow + H1 + description + script
                     line) on the left over the blanket area.
       Mobile (<lg): banner inline natural aspect; eyebrow + H1
                     overlay on its LEFT HALF; description + script
                     stack BELOW the image. -->
  <section class="relative overflow-hidden bg-gradient-to-b from-[#F1F7FD] to-[#E6F0FB] lg:aspect-[5/2]">
    <picture class="lg:absolute lg:inset-0 lg:block lg:h-full lg:w-full">
      <img
        src="/images/hero/blog-banner.jpg"
        alt="Smiling baby on a soft blanket surrounded by a baby milestones journal, ultrasound photo, bottle, blue knit blanket, and a teddy bear"
        class="block w-full h-auto lg:h-full lg:w-full lg:object-cover lg:object-[35%_40%]"
        width="2000"
        height="1000"
        loading="eager"
        fetchpriority="high"
      />
    </picture>

    <!-- MOBILE-ONLY title overlay: eyebrow + H1 anchored to the TOP-
         LEFT of the banner so the text floats on the photo's pale
         pillow / white blanket zone (not the blue knit blanket below). -->
    <div class="lg:hidden absolute top-0 left-0 right-1/2 pt-4 sm:pt-6 px-5 z-10">
      <span class="inline-flex w-fit items-center gap-1.5 text-[10px] font-semibold text-[#2E6FB8] bg-white/90 px-2.5 py-1 rounded-full mb-2 shadow-sm">
        <span aria-hidden="true">♡</span> OUR BLOG
      </span>
      <h1 class="font-display text-[#1E3A5F] leading-[1.1] text-2xl sm:text-3xl">
        Baby Care<br/>Blog
      </h1>
    </div>

    <!-- DESKTOP-ONLY full text overlay (anchored toward the top so
         the script line doesn't land on the blue blanket) -->
    <div class="hidden lg:flex absolute inset-0 max-w-7xl mx-auto px-5 items-start z-10">
      <div class="max-w-xl pt-10 xl:pt-14">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#2E6FB8] bg-white/90 px-3 py-1.5 rounded-full mb-4 shadow-sm"><span aria-hidden="true">♡</span> OUR BLOG</span>
        <h1 class="font-display text-[#1E3A5F] leading-[1.1] mb-3 text-4xl xl:text-5xl">Baby Care Blog</h1>
        <p class="text-[#3F5575] text-base leading-relaxed max-w-md mb-2">
          Expert articles for every stage of your baby's first years.
        </p>
        <p class="text-sm text-[#5A6F89]">Helpful tips. Trusted advice. Real support.</p>
        <p class="mt-3 font-display italic text-[#5B9BD5] text-base">You're doing great, mama. <span aria-hidden="true">♡</span></p>
      </div>
    </div>

    <!-- MOBILE-ONLY description + script (stacks below the banner) -->
    <div class="lg:hidden max-w-7xl mx-auto px-5 py-6">
      <p class="text-[#3F5575] text-sm leading-relaxed max-w-md mb-2">
        Expert articles for every stage of your baby's first years.
      </p>
      <p class="text-xs text-[#5A6F89]">Helpful tips. Trusted advice. Real support.</p>
      <p class="mt-3 font-display italic text-[#5B9BD5] text-base">You're doing great, mama. <span aria-hidden="true">♡</span></p>
    </div>
  </section>

  <!-- ───────── BLOG LAYOUT: ARTICLES + SIDEBAR ───────── -->
  <section class="max-w-7xl mx-auto px-5 py-14 grid lg:grid-cols-[1fr_320px] gap-10">
    <!-- ARTICLES LIST -->
    <div>
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-display text-2xl text-[#1E3A5F] m-0">Latest Articles</h2>
        <label class="text-sm text-[#6B7B91] flex items-center gap-2">
          Sort by:
          <select class="px-3 py-1.5 rounded-full border border-[#D5E6F4] bg-white text-[#1E3A5F] text-sm">
            <option>Latest</option>
            <option>Oldest</option>
            <option>Popular</option>
          </select>
        </label>
      </div>

      {allPosts.length > 0 ? (
        <div class="flex flex-col gap-5" id="articles-grid" data-initial="6">
          {allPosts.map((p, i) => (
            <a href={`/blog/${p.data.slug || p.slug}/`} data-cat={(p.data.category || "").toLowerCase()} class={`article-item group flex flex-col sm:flex-row gap-4 bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow no-underline ${i >= 6 ? 'hidden' : ''}`}>
              <div class="sm:w-56 shrink-0">
                {p.data.image ? (
                  <img src={p.data.image} alt={p.data.title} class="w-full h-44 sm:h-full object-cover object-[50%_25%]" loading="lazy" />
                ) : (
                  <div class="w-full h-44 sm:h-full bg-gradient-to-br from-[#E6F0FB] to-[#FBE6EE]"></div>
                )}
              </div>
              <div class="flex-1 p-5">
                {p.data.category && (
                  <span class="inline-block text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full mb-3" style={`background:${catColor(p.data.category)}25; color:${catColor(p.data.category)};`}>{p.data.category}</span>
                )}
                <h3 class="font-display text-lg font-bold text-[#1E3A5F] mb-2 leading-snug group-hover:text-[#2E6FB8] transition-colors">{p.data.title}</h3>
                <p class="text-sm text-[#6B7B91] leading-relaxed line-clamp-2 mb-3">{p.data.description}</p>
                <div class="flex items-center gap-3 text-xs text-[#6B7B91]">
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-[#E6F0FB] text-[#2E6FB8]" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-4 0-8 2-8 6v2h16v-2c0-4-4-6-8-6z"/></svg>
                  </span>
                  <span>By Baby Care Team</span>
                  <span aria-hidden="true">·</span>
                  <span>{new Date(p.data.publishDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
                  {p.data.readTime && <><span aria-hidden="true">·</span><span>{p.data.readTime}</span></>}
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-[#6B7B91]">Articles coming soon.</p>
      )}

      {allPosts.length > 6 && (
        <div class="text-center mt-10">
          <button
            type="button"
            id="load-more-btn"
            data-step="6"
            class="inline-flex items-center gap-2 bg-white border border-[#D5E6F4] hover:border-[#5B9BD5] hover:text-[#2E6FB8] text-[#1E3A5F] text-sm font-semibold px-6 py-2.5 rounded-full transition-colors"
          >
            Load More Articles <span aria-hidden="true">↓</span>
          </button>
        </div>
      )}
    </div>

    <!-- SIDEBAR -->
    <aside class="space-y-7">
      <!-- Search — id="search" so the header search button can deep-link
           to /blog/#search and the inline script below auto-focuses the
           input + scrolls into view when the page loads with that hash. -->
      <form id="search" action="/blog/" method="get" class="relative scroll-mt-24">
        <input id="blog-search-input" type="search" name="q" placeholder="Search articles..." class="w-full px-4 py-3 pr-10 rounded-full bg-white border border-[#D5E6F4] text-sm text-[#1E3A5F] placeholder:text-[#94A8C2]" />
        <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 w-7 h-7 inline-flex items-center justify-center rounded-full text-[#2E6FB8]" aria-label="Search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>
      </form>
      <script is:inline>
        // When user clicks the header search icon (/blog/#search), bring the
        // search input into view AND give it cursor focus so they can type
        // immediately. Plain hash anchors only scroll; they don't focus.
        if (window.location.hash === '#search') {
          const input = document.getElementById('blog-search-input');
          if (input) setTimeout(() => input.focus({ preventScroll: false }), 100);
        }
      </script>

      <!-- Categories -->
      <div class="bg-white rounded-2xl p-5 shadow-sm">
        <h3 class="font-display font-bold text-[#1E3A5F] mb-4">Categories</h3>
        <ul class="space-y-2 m-0 p-0 list-none">
          {categoryDefs.map((c) => (
            <li>
              <a href={`/${c.id}/`} class="flex items-center justify-between text-sm text-[#1E3A5F] hover:text-[#2E6FB8] no-underline py-1.5">
                <span class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full" style={`background:${c.color};`}></span>
                  {c.label}
                </span>
                <span class="text-xs text-[#94A8C2]">{counts[c.id] || 0}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Popular Articles -->
      {popularPosts.length > 0 && (
        <div class="bg-white rounded-2xl p-5 shadow-sm">
          <h3 class="font-display font-bold text-[#1E3A5F] mb-4">Popular Articles</h3>
          <ul class="space-y-3 m-0 p-0 list-none">
            {popularPosts.map((p) => (
              <li>
                <a href={`/blog/${p.data.slug || p.slug}/`} class="flex gap-3 no-underline">
                  {p.data.image ? (
                    <img src={p.data.image} alt="" class="w-14 h-14 rounded-lg object-cover shrink-0" loading="lazy" />
                  ) : (
                    <span class="w-14 h-14 rounded-lg bg-gradient-to-br from-[#E6F0FB] to-[#FBE6EE] shrink-0"></span>
                  )}
                  <div class="flex-1">
                    <h4 class="text-xs font-bold text-[#1E3A5F] leading-snug line-clamp-2 mb-1">{p.data.title}</h4>
                    <span class="text-[10px] text-[#94A8C2]">{new Date(p.data.publishDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Newsletter -->
      <div class="bg-gradient-to-br from-[#E6F0FB] to-[#D5E6F4] rounded-2xl p-5">
        <h3 class="font-display font-bold text-[#1E3A5F] mb-1">Stay in the Loop</h3>
        <p class="text-xs text-[#6B7B91] mb-3 leading-relaxed">Get helpful tips and updates delivered to your inbox.</p>
        <form action="#" onsubmit="event.preventDefault();" class="space-y-2">
          <input type="email" placeholder="Your email address" class="w-full px-4 py-2.5 rounded-full bg-white text-sm text-[#1E3A5F] border border-transparent" />
          <button type="submit" class="w-full bg-[#5B9BD5] hover:bg-[#2E6FB8] text-white text-sm font-semibold px-4 py-2.5 rounded-full transition-colors">
            Subscribe <span aria-hidden="true">♡</span>
          </button>
        </form>
      </div>

    </aside>
  </section>
</BaseLayout>

<script>
  // ─── Load More — reveal `step` more articles per click ──────────────
  // Initial state: only first 6 .article-item nodes are visible.
  // Each click un-hides the next 6 (driven by data-step on the button).
  // When everything is visible, the button auto-hides.
  const btn = document.getElementById("load-more-btn");
  if (btn) {
    btn.addEventListener("click", () => {
      const step = parseInt(btn.dataset.step ?? "6", 10);
      const hidden = document.querySelectorAll<HTMLElement>(".article-item.hidden");
      Array.from(hidden).slice(0, step).forEach((el) => el.classList.remove("hidden"));
      if (document.querySelectorAll(".article-item.hidden").length === 0) {
        btn.style.display = "none";
      }
    });
  }
</script>

<style>
  .sidebar-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #E6F0FB;
    color: #2E6FB8;
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }
  .sidebar-social:hover {
    background: #5B9BD5;
    color: #fff;
    transform: translateY(-2px);
  }
</style>
