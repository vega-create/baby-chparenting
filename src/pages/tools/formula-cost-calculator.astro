---
import ToolLayout from "../../layouts/ToolLayout.astro";
import AdSenseLazy from "../../components/AdSenseLazy.astro";
import FormulaCostCalculator from "../../components/tools/FormulaCostCalculator.jsx";

const title = "Formula & Diaper Cost Calculator: Monthly Baby Budget — Baby Care Guide";
const description =
  "Estimate what formula and diapers cost per month based on your baby's weight and the prices at your store. Compare two formulas by price per ounce.";

const faqs = [
  {
    q: "How much formula does a baby drink per day?",
    a: "A common rule of thumb from the American Academy of Pediatrics is about 2.5 ounces of formula per pound of body weight per day, up to a maximum of around 32 ounces. A 10-pound baby needs roughly 25 ounces a day. Appetite varies, so watch your baby's hunger and fullness cues rather than the number.",
  },
  {
    q: "Why do I enter the 'makes' ounces instead of the can weight?",
    a: "Formula is sold by powder weight (for example 20 oz of powder), but you feed it by prepared liquid ounces. Each can states roughly how many fluid ounces it makes — often 140 to 150 fl oz for a 20 oz can. Using that number gives a true cost per feeding.",
  },
  {
    q: "Is store-brand formula safe?",
    a: "All infant formula sold in the US must meet the same FDA nutrition and safety standards, whether name-brand or store-brand. Store brands are often significantly cheaper per ounce. If you switch, your pediatrician can help you choose a comparable type.",
  },
  {
    q: "How many diapers does a baby use per day?",
    a: "Newborns commonly go through 8–10 diapers a day, dropping to around 6–8 by a few months old and 4–6 for toddlers. The default of 8 per day fits most young babies; adjust it to what you actually see.",
  },
  {
    q: "Does the calculator include wipes, bottles, or water?",
    a: "No — it covers the two biggest recurring costs: formula and diapers. Wipes, bottle liners, and distilled water add a smaller amount. For a full first-year picture, use the baby cost calculator on our sister site.",
  },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<ToolLayout
  title={title}
  description={description}
  toolName="Formula & Diaper Cost Calculator"
  toolTagline="Monthly formula and diaper spending, from your baby's weight and your store's prices"
  icon="bottle"
  theme="green"
  tipsHeading="Ways to spend less"
  tips={[
    { title: "Compare per ounce, not per can", desc: "Can sizes differ by brand. The price per prepared ounce is the only fair comparison.", icon: "bulb" },
    { title: "Don't over-prepare", desc: "Prepared formula must be used within an hour once feeding starts. Mix smaller bottles to cut waste.", icon: "leaf" },
    { title: "Size up on time", desc: "Diapers get cheaper per unit in bigger packs — but a leaking too-small size wastes more than it saves.", icon: "star" },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <h1 class="mb-3">Formula &amp; Diaper Cost Calculator</h1>
  <p class="text-lg text-[#9CA3AF] mb-8 max-w-2xl">
    Enter your baby's weight to estimate daily formula, add the can price and how many ounces it makes, then the
    diaper price. You get a monthly total, a cost per feeding, and a side-by-side of two formulas.
  </p>

  <FormulaCostCalculator client:load />

  <section class="mt-12">
    <h2 class="mb-4">How the formula estimate works</h2>
    <div class="card space-y-3 leading-relaxed">
      <p>
        The daily amount starts from the American Academy of Pediatrics' rule of thumb of about <strong>2.5 fl oz of
        formula per pound of body weight per day</strong>, capped at roughly 32 oz. A 12-pound baby lands near 30 oz a day,
        split across 6–8 bottles. The <a href="/tools/bottle-calculator/">bottle calculator</a> breaks that into ounces per
        feed by age, and our guide on <a href="/blog/how-much-milk-by-age/">how much milk babies need by age</a> explains how
        intake changes once solids start around 6 months.
      </p>
      <p>
        Cost is then simply ounces per day × price per prepared ounce. Because brands sell different can sizes, the
        calculator asks for the "makes approximately X fl oz" figure printed on the label — that number already accounts
        for the scoop-to-water ratio, so it works for any powder.
      </p>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="mb-4">What formula really costs over the first year</h2>
    <div class="card space-y-3 leading-relaxed">
      <p>
        Intake rises quickly in the first months and then plateaus, so your monthly bill will climb from the newborn weeks,
        peak somewhere around 4–6 months, and ease once solids take over part of the calories. Run the calculator again
        each time your baby gains a few pounds to keep the estimate honest.
      </p>
      <p>
        The biggest lever is price per ounce. Store-brand formulas must meet the same FDA requirements as name brands and are
        often much cheaper; specialty formulas (hypoallergenic, extensively hydrolyzed) can cost two to three times more. If
        your pediatrician recommends a specialty formula, ask whether your insurance or WIC covers it. Our
        <a href="/blog/formula-feeding-complete-guide/">formula feeding guide</a> covers types, preparation, and safe storage.
      </p>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="mb-4">Diapers: counting the real number</h2>
    <div class="card space-y-3 leading-relaxed">
      <p>
        Newborns can use 8–10 diapers a day; by 6 months most babies are closer to 6, and toddlers 4–6. Over a year that is
        easily 2,500 diapers. Unit prices range widely by brand and pack size, so bulk boxes and subscriptions usually win —
        but buy only one box of a new size until you know it fits, and change promptly to avoid
        <a href="/blog/diaper-rash-causes-treatment-prevention/">diaper rash</a>. Use the
        <a href="/tools/diaper-size/">diaper size guide</a> to pick the right size by weight.
      </p>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="mb-4">Frequently asked questions</h2>
    <div class="space-y-3">
      {faqs.map((f) => (
        <details class="card">
          <summary class="font-bold text-[#1E3A5F] cursor-pointer">{f.q}</summary>
          <p class="mt-3 leading-relaxed text-[#374151]">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mt-10">
    <div class="card text-sm text-[#6B7B91]">
      <p class="font-semibold text-[#1E3A5F] mb-2">References</p>
      <ul class="list-disc pl-5 space-y-1">
        <li>American Academy of Pediatrics, HealthyChildren.org. "<a href="https://www.healthychildren.org/English/ages-stages/baby/formula-feeding/Pages/Amount-and-Schedule-of-Formula-Feedings.aspx" rel="noopener" target="_blank">Amount and Schedule of Formula Feedings</a>."</li>
        <li>Centers for Disease Control and Prevention. "<a href="https://www.cdc.gov/infant-toddler-nutrition/formula-feeding/preparation-and-storage.html" rel="noopener" target="_blank">Infant Formula Preparation and Storage</a>."</li>
      </ul>
      <p class="mt-3 italic">Estimates only, not medical advice. Ask your pediatrician how much your baby should be eating.</p>
    </div>
  </section>

  {/* wrapped in a div: a bare `slot=` attr on a direct child of ToolLayout would be treated as a named slot */}
  <div class="mt-8"><AdSenseLazy unit="bottom" /></div>
</ToolLayout>
