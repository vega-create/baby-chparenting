---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../../site.config";

/* Tools page — now using the user-supplied 3D illustrated assets
   in public/images/tools/ for the hero banner, every tool icon,
   the "How It Works" diagram, and the bottom free-tools banner.
   Each tool entry now carries an `img` field pointing at one of the
   icon JPEGs; some icons (sleep/feeding/growth/names/feet) get
   reused across both the Popular Tools row AND the per-category
   sections to keep the visual language tight. */

const popularTools = [
  {
    title: "Sleep Tracker",
    desc:  "Track naps, nighttime sleep, and sleep patterns.",
    href:  "/tools/sleep-tracker/",
    theme: { bg: "#E6F0FB", btnBg: "#E6F0FB", btnText: "#2E6FB8" },
    img:   "/images/tools/icon-sleep.jpg",
  },
  {
    title: "Feeding Timer",
    desc:  "Track feedings, bottles or nursing sessions.",
    href:  "/tools/feeding-timer/",
    theme: { bg: "#DDF0E5", btnBg: "#CFE9D6", btnText: "#3E8A66" },
    img:   "/images/tools/icon-feeding.jpg",
  },
  {
    title: "Growth Calculator",
    desc:  "Track height, weight, and head circumference.",
    href:  "/tools/growth-calculator/",
    theme: { bg: "#FBEED5", btnBg: "#F8E1B7", btnText: "#A37224" },
    img:   "/images/tools/icon-growth-ruler.jpg",
  },
  {
    title: "Name Generator",
    desc:  "Find beautiful baby names and their meanings.",
    href:  "/tools/name-generator/",
    theme: { bg: "#E4DEF0", btnBg: "#D7CCEB", btnText: "#6C5BA1" },
    img:   "/images/tools/icon-names.jpg",
  },
  {
    title: "Milestone Tracker",
    desc:  "Track developmental milestones with ease.",
    href:  "/tools/milestone-checker/",
    theme: { bg: "#E6F0FB", btnBg: "#D5E6F4", btnText: "#2E6FB8" },
    img:   "/images/tools/icon-feet.jpg",
  },
];

/* Per-category groups. The `img` here drives the category chip icon
   AND the section heading icon. Health & Safety + Gear pull in the
   new heart + stroller PNGs; Growth uses the bar-chart variant to
   differentiate from the ruler used in the popular-tools row. */
const catGroups = [
  {
    slug: "sleep", label: "Sleep", color: "#5B9BD5", bg: "#E6F0FB",
    img: "/images/tools/icon-sleep.jpg",
    tools: [
      { title: "Sleep Tracker",      desc: "Log naps, nighttime sleep, and patterns.",     href: "/tools/sleep-tracker/" },
      { title: "Bedtime Calculator", desc: "Find baby's ideal bedtime by age + wake time.", href: "/tools/bedtime-calculator/" },
      { title: "White Noise",        desc: "Soothing sounds to help baby fall asleep.",     href: "/tools/white-noise/" },
    ],
  },
  {
    slug: "feeding", label: "Feeding", color: "#7BC0A0", bg: "#DDF0E5",
    img: "/images/tools/icon-feeding.jpg",
    tools: [
      { title: "Feeding Timer",     desc: "Time breastfeeding sessions or bottles.",   href: "/tools/feeding-timer/" },
      { title: "Bottle Calculator", desc: "Work out daily formula / breast-milk needs.", href: "/tools/bottle-calculator/" },
      { title: "Solids Readiness",  desc: "Quiz: is baby ready for solid food?",        href: "/tools/solids-readiness/" },
    ],
  },
  {
    slug: "growth", label: "Growth", color: "#E8B86E", bg: "#FBEED5",
    img: "/images/tools/icon-chart.jpg",
    tools: [
      { title: "Growth Calculator",  desc: "Plot weight + length on WHO percentile.",     href: "/tools/growth-calculator/" },
      { title: "Tummy Time Tracker", desc: "Log daily tummy-time with a 7-day history.",  href: "/tools/tummy-time/" },
    ],
  },
  {
    slug: "names", label: "Names", color: "#A89BD4", bg: "#E4DEF0",
    img: "/images/tools/icon-names.jpg",
    tools: [
      { title: "Name Generator", desc: "Discover names with meanings and origins.",      href: "/tools/name-generator/" },
      { title: "Sibling Names",  desc: "Find names that pair with an existing sibling.", href: "/tools/sibling-names/" },
      { title: "Name Trends",    desc: "See a name's popularity over the decades.",      href: "/tools/name-trends/" },
    ],
  },
  {
    slug: "development", label: "Development", color: "#5B9BD5", bg: "#E6F0FB",
    img: "/images/tools/icon-feet.jpg",
    tools: [
      { title: "Milestone Checker", desc: "Track milestones from newborn to 24 months.", href: "/tools/milestone-checker/" },
      { title: "Language Quiz",     desc: "Check baby's language milestones by age.",     href: "/tools/language-quiz/" },
    ],
  },
  {
    slug: "health-safety", label: "Health & Safety", color: "#E89BAE", bg: "#FBE0E6",
    img: "/images/tools/icon-heart.jpg",
    tools: [
      { title: "Car Seat Finder", desc: "Pick the right car-seat by age + weight.", href: "/tools/car-seat-finder/" },
    ],
  },
  {
    slug: "gear", label: "Gear", color: "#5B9BD5", bg: "#E6F0FB",
    img: "/images/tools/icon-stroller.jpg",
    tools: [
      { title: "Diaper Size Guide", desc: "Find the right diaper size by baby's weight.", href: "/tools/diaper-size/" },
    ],
  },
];

const categories = catGroups.map((g) => ({
  slug:  g.slug,
  label: g.label,
  count: g.tools.length,
  color: g.color,
  bg:    g.bg,
  img:   g.img,
}));
---

<BaseLayout
  title={`Tools — ${siteConfig.name}`}
  description="Free, easy-to-use baby care tools — sleep tracker, feeding timer, growth calculator, name generator, milestone tracker and more."
>
  <!-- ───────── HERO ─────────
       Full-width banner: the user-supplied tools-banner.jpg is the
       SECTION'S BACKGROUND (object-cover, full bleed); the eyebrow
       + H1 + sub-copy + CTA sit ABSOLUTELY over the left third where
       the photo is mostly blank pale-blue, so the baby + teddy on
       the right are not obscured.

       Mobile (<lg): image stacked on top in natural aspect, text +
                    CTA below in a normal flow block.
       Desktop (lg+): image fills the section via lg:absolute lg:inset-0
                     and lg:object-cover; text overlay positioned with
                     absolute + items-center.
       -->
  <section class="relative overflow-hidden bg-gradient-to-b from-[#F1F7FD] to-[#E6F0FB] lg:aspect-[1600/693]">
    <picture class="lg:absolute lg:inset-0 lg:block lg:h-full lg:w-full">
      <img
        src="/images/tools/tools-banner.jpg"
        alt="Smiling baby in a blue onesie holding a teddy bear on a soft blue bed surrounded by pastel stars and clouds"
        class="block w-full h-auto lg:h-full lg:w-full lg:object-cover lg:object-[80%_center]"
        width="1600"
        height="693"
        loading="eager"
        fetchpriority="high"
      />
    </picture>

    <!-- DESKTOP-ONLY text overlay over the photo's left zone -->
    <div class="hidden lg:flex absolute inset-0 max-w-7xl mx-auto px-5 items-center z-10">
      <div class="max-w-xl">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#2E6FB8] bg-white/85 px-3 py-1.5 rounded-full mb-5 shadow-sm">
          <span aria-hidden="true">♡</span> TOOLS &amp; RESOURCES
        </span>
        <h1 class="font-display text-[#1E3A5F] leading-[1.1] mb-5 text-4xl xl:text-5xl">
          Helpful Tools for<br/>Every Stage of Parenting
        </h1>
        <p class="text-[#3F5575] text-base md:text-lg leading-relaxed max-w-md mb-7">
          Free, easy-to-use tools designed to support you and your baby's growth every step of the way.
        </p>
        <a href="/tools/all/" class="inline-flex items-center gap-2 bg-[#5B9BD5] hover:bg-[#2E6FB8] text-white font-semibold px-6 py-3 rounded-full no-underline transition-colors shadow-md">
          Explore All Tools <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- MOBILE-ONLY text block under the photo -->
    <div class="lg:hidden max-w-7xl mx-auto px-5 pt-8 pb-10">
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#2E6FB8] bg-white/85 px-3 py-1.5 rounded-full mb-4 shadow-sm">
        <span aria-hidden="true">♡</span> TOOLS &amp; RESOURCES
      </span>
      <h1 class="font-display text-[#1E3A5F] leading-[1.15] mb-4 text-3xl sm:text-4xl">
        Helpful Tools for<br/>Every Stage of Parenting
      </h1>
      <p class="text-[#3F5575] text-sm md:text-base leading-relaxed mb-6">
        Free, easy-to-use tools designed to support you and your baby's growth every step of the way.
      </p>
      <a href="/tools/all/" class="inline-flex items-center gap-2 bg-[#5B9BD5] hover:bg-[#2E6FB8] text-white font-semibold px-6 py-3 rounded-full no-underline transition-colors shadow-md">
        Explore All Tools <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  <svg class="block w-full text-[#F8FAFC] -mb-px" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,30 C360,60 720,0 1080,30 C1260,45 1380,15 1440,30 L1440,60 L0,60 Z" fill="currentColor"/>
  </svg>

  <!-- ───────── POPULAR TOOLS ───────── -->
  <section id="popular-tools" class="max-w-7xl mx-auto px-5 py-14">
    <div class="text-center mb-10">
      <h2 class="font-display text-2xl md:text-3xl text-[#1E3A5F] mb-2 flex items-center justify-center gap-2">
        <span class="text-[#5B9BD5] text-lg">♡</span> Popular Tools <span class="text-[#5B9BD5] text-lg">♡</span>
      </h2>
      <p class="text-[#6B7B91]">Our most loved tools by parents like you.</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5">
      {popularTools.map((t) => (
        <a href={t.href} class="group flex flex-col bg-white rounded-2xl shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all overflow-hidden no-underline">
          <div class="aspect-square flex items-center justify-center p-6" style={`background:${t.theme.bg};`}>
            <img src={t.img} alt={t.title + " icon"} class="block max-w-[78%] max-h-[78%] w-auto h-auto object-contain mix-blend-multiply" loading="lazy" />
          </div>
          <div class="p-5 text-center flex-1 flex flex-col">
            <h3 class="font-display font-bold text-[15px] text-[#1E3A5F] mb-2">{t.title}</h3>
            <p class="text-xs text-[#6B7B91] leading-relaxed mb-4 flex-1">{t.desc}</p>
            <span class="inline-flex items-center justify-center gap-1.5 text-xs font-semibold rounded-full px-4 py-2 mx-auto" style={`background:${t.theme.btnBg}; color:${t.theme.btnText};`}>
              Use Tool <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ───────── BROWSE BY CATEGORY ───────── -->
  <section class="max-w-7xl mx-auto px-5 py-10">
    <div class="text-center mb-8">
      <h2 class="font-display text-2xl md:text-3xl text-[#1E3A5F] mb-2">Browse by Category</h2>
      <p class="text-[#6B7B91]">Find the right tool for what you need.</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3">
      {categories.map((c) => (
        <a href={`/tools/all/?cat=${c.slug}`} class="group flex items-center gap-3 bg-white border border-[#E6F0FB] rounded-2xl p-3 hover:shadow-md hover:-translate-y-0.5 transition-all no-underline">
          <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl shrink-0 overflow-hidden" style={`background:${c.bg};`} aria-hidden="true">
            <img src={c.img} alt="" class="block w-9 h-9 object-contain mix-blend-multiply" loading="lazy" />
          </span>
          <div class="flex-1 min-w-0">
            <div class="font-bold text-sm text-[#1E3A5F] truncate">{c.label}</div>
            <div class="text-xs text-[#6B7B91]">{c.count} tools</div>
          </div>
          <span class="text-[#94A8C2] group-hover:text-[#2E6FB8] transition-colors" aria-hidden="true">›</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ───────── ALL TOOLS BY CATEGORY ───────── -->
  <section class="max-w-7xl mx-auto px-5 pt-4 pb-12 scroll-mt-24">
    {catGroups.map((g) => (
      <div id={`cat-${g.slug}`} class="scroll-mt-24 mb-10">
        <div class="flex items-center gap-3 mb-4">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl overflow-hidden" style={`background:${g.bg};`} aria-hidden="true">
            <img src={g.img} alt="" class="block w-10 h-10 object-contain mix-blend-multiply" loading="lazy" />
          </span>
          <div>
            <h2 class="font-display text-xl text-[#1E3A5F] m-0">{g.label} Tools</h2>
            <p class="text-xs text-[#6B7B91] m-0">{g.tools.length} tools in this category</p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {g.tools.map((t) => (
            <a href={t.href} class="group block bg-white rounded-2xl p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all no-underline border border-transparent hover:border-[#E6F0FB]">
              <h3 class="font-bold text-[15px] text-[#1E3A5F] mb-1.5 group-hover:text-[#2E6FB8] transition-colors">{t.title}</h3>
              <p class="text-xs text-[#6B7B91] leading-relaxed mb-3">{t.desc}</p>
              <span class="text-xs font-semibold inline-flex items-center gap-1" style={`color:${g.color};`}>Use Tool <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- ───────── HOW IT WORKS ─────────
       The user-supplied works-steps.jpg already bakes in the 4
       numbered steps (Create Profile → Record Details → Track
       Growth → Stay Connected) plus the friendly plush dog mascot.
       Desktop: image fills the card width (max-w-7xl ≈ 1280px) with
       only light inner padding. Mobile: the card has tighter
       horizontal padding so the diagram doesn't shrink too much. -->
  <section class="px-5 py-16 lg:py-20">
    <div class="max-w-[1400px] mx-auto bg-[#F1F7FD] rounded-3xl py-10 lg:py-14 px-4 sm:px-6 md:px-8 lg:px-10">
      <div class="text-center mb-8 lg:mb-10">
        <h2 class="font-display text-2xl md:text-3xl lg:text-4xl text-[#1E3A5F] flex items-center justify-center gap-3">
          <span class="text-[#5B9BD5]">♡</span> How It Works <span class="text-[#5B9BD5]">♡</span>
        </h2>
        <p class="text-[#6B7B91] mt-3 text-sm md:text-base lg:text-lg">Four simple steps from sign-up to confident parenting.</p>
      </div>
      <img
        src="/images/tools/works-steps.jpg"
        alt="Four-step process diagram: 1. Create Profile, 2. Record Details, 3. Track Growth, 4. Stay Connected — with a plush puppy mascot on the right"
        class="block w-full h-auto rounded-2xl"
        width="1400"
        height="630"
        loading="lazy"
      />
    </div>
  </section>

  <!-- ───────── BOTTOM CTA STRIP ─────────
       The free-tools-banner.jpg already contains the headline +
       sub-copy + cloud mascot, so the banner image IS the CTA copy.
       Banner spans the full container on desktop; the Explore CTA
       sits below as a standalone pill. -->
  <section class="max-w-[1400px] mx-auto px-5 pb-20">
    <div class="rounded-3xl overflow-hidden shadow-sm">
      <img
        src="/images/tools/free-tools-banner.jpg"
        alt="All our tools are free and always will be. Created with love by parents, for parents."
        class="block w-full h-auto"
        width="1400"
        height="494"
        loading="lazy"
      />
    </div>
    <div class="text-center mt-8">
      <a href="/tools/all/" class="inline-flex items-center gap-2 bg-[#5B9BD5] hover:bg-[#2E6FB8] text-white text-base font-semibold px-8 py-3.5 rounded-full no-underline transition-colors shadow-md">
        Explore All Tools <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
