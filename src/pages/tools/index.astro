---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../../site.config";

// ─── 5 Popular tool cards ────────────────────────────────────────────
// Each tool carries its own pastel theme so the row reads as a
// playful palette but stays cohesive (matches the mockup).
const popularTools = [
  {
    title: "Sleep Tracker",
    desc:  "Track naps, nighttime sleep, and sleep patterns.",
    href:  "/tools/sleep-tracker/",
    theme: { bg: "#E6F0FB", btnBg: "#E6F0FB", btnText: "#2E6FB8", iconColor: "#5B9BD5" },
    icon:  "moon",
  },
  {
    title: "Feeding Timer",
    desc:  "Track feedings, bottles or nursing sessions.",
    href:  "/tools/feeding-timer/",
    theme: { bg: "#DDF0E5", btnBg: "#CFE9D6", btnText: "#3E8A66", iconColor: "#7BC0A0" },
    icon:  "bottle",
  },
  {
    title: "Growth Calculator",
    desc:  "Track height, weight, and head circumference.",
    href:  "/tools/growth-calculator/",
    theme: { bg: "#FBEED5", btnBg: "#F8E1B7", btnText: "#A37224", iconColor: "#E8B86E" },
    icon:  "ruler",
  },
  {
    title: "Name Generator",
    desc:  "Find beautiful baby names and their meanings.",
    href:  "/tools/name-generator/",
    theme: { bg: "#E4DEF0", btnBg: "#D7CCEB", btnText: "#6C5BA1", iconColor: "#A89BD4" },
    icon:  "blocks",
  },
  {
    title: "Milestone Tracker",
    desc:  "Track developmental milestones with ease.",
    href:  "/tools/milestone-checker/",
    theme: { bg: "#E6F0FB", btnBg: "#D5E6F4", btnText: "#2E6FB8", iconColor: "#5B9BD5" },
    icon:  "feet",
  },
];

// ─── 7 Browse-by-category pills ──────────────────────────────────────
const categories = [
  { label: "Sleep",          count: 6, href: "/sleep/",       color: "#5B9BD5", bg: "#E6F0FB", icon: "moon"   },
  { label: "Feeding",        count: 6, href: "/feeding/",     color: "#7BC0A0", bg: "#DDF0E5", icon: "bottle" },
  { label: "Growth",         count: 4, href: "/tools/growth-calculator/", color: "#E8B86E", bg: "#FBEED5", icon: "chart" },
  { label: "Names",          count: 4, href: "/names/",       color: "#A89BD4", bg: "#E4DEF0", icon: "blocks" },
  { label: "Development",    count: 5, href: "/development/", color: "#5B9BD5", bg: "#E6F0FB", icon: "feet"   },
  { label: "Health & Safety",count: 5, href: "/tools/",       color: "#E89BAE", bg: "#FBE0E6", icon: "heart"  },
  { label: "Gear",           count: 5, href: "/gear/",        color: "#B68C73", bg: "#F1E2D3", icon: "stroller" },
];

// ─── 4-step process ──────────────────────────────────────────────────
const steps = [
  { n: 1, color: "#5B9BD5", title: "Choose a Tool",   desc: "Pick the tool that matches your need.", icon: "laptop" },
  { n: 2, color: "#7BC0A0", title: "Enter Details",   desc: "Add a few details about you and your baby.", icon: "clipboard" },
  { n: 3, color: "#E8B86E", title: "Get Results",     desc: "See personalized results and recommendations.", icon: "chart" },
  { n: 4, color: "#A89BD4", title: "Feel Confident",  desc: "Use the insights to make informed decisions.", icon: "heart" },
];
---

<BaseLayout
  title={`Tools — ${siteConfig.name}`}
  description="Free, easy-to-use baby care tools — sleep tracker, feeding timer, growth calculator, name generator, milestone tracker and more."
>
  <!-- ───────── HERO ───────── -->
  <section class="relative bg-gradient-to-b from-[#F1F7FD] to-[#E6F0FB] overflow-hidden">
    <div class="max-w-7xl mx-auto px-5 pt-12 md:pt-16 pb-16 md:pb-24 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#2E6FB8] bg-white/80 px-3 py-1.5 rounded-full mb-5">
          <span aria-hidden="true">♡</span> TOOLS &amp; RESOURCES
        </span>
        <h1 class="font-display text-[#1E3A5F] leading-[1.1] mb-5 text-4xl md:text-5xl">
          Helpful Tools for<br/>Every Stage of Parenting
        </h1>
        <p class="text-[#5A6F89] text-base md:text-lg leading-relaxed max-w-md mb-7">
          Free, easy-to-use tools designed to support you and your baby's growth every step of the way.
        </p>
        <a href="#popular-tools" class="inline-flex items-center gap-2 bg-[#5B9BD5] hover:bg-[#2E6FB8] text-white font-semibold px-6 py-3 rounded-full no-underline transition-colors">
          Explore All Tools <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="relative">
        <div class="aspect-[4/3] rounded-3xl overflow-hidden bg-gradient-to-br from-[#E6F0FB] via-[#F0E6FB] to-[#FBF0E6] shadow-md flex items-center justify-center text-[#6B7B91] text-sm">
          <span class="opacity-50">Baby with teddy hero photo</span>
        </div>
        <span class="absolute -top-2 left-6 text-2xl opacity-70" aria-hidden="true">⭐</span>
        <span class="absolute top-5 -right-2 text-2xl opacity-70" aria-hidden="true">☁️</span>
        <span class="absolute bottom-10 -left-3 text-xl opacity-60" aria-hidden="true">⭐</span>
      </div>
    </div>
    <svg class="block w-full text-white" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,30 C360,60 720,0 1080,30 C1260,45 1380,15 1440,30 L1440,60 L0,60 Z" fill="currentColor"/>
    </svg>
  </section>

  <!-- ───────── POPULAR TOOLS ───────── -->
  <section id="popular-tools" class="max-w-7xl mx-auto px-5 py-14">
    <div class="text-center mb-10">
      <h2 class="font-display text-2xl md:text-3xl text-[#1E3A5F] mb-2 flex items-center justify-center gap-2">
        <span class="text-[#5B9BD5] text-lg">♡</span> Popular Tools <span class="text-[#5B9BD5] text-lg">♡</span>
      </h2>
      <p class="text-[#6B7B91]">Our most loved tools by parents like you.</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5">
      {popularTools.map((t) => (
        <a href={t.href} class="group flex flex-col bg-white rounded-2xl shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all overflow-hidden no-underline">
          <div class="aspect-square flex items-center justify-center" style={`background:${t.theme.bg};`}>
            <span aria-hidden="true" style={`color:${t.theme.iconColor};`}>
              {t.icon === "moon"   && <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/><circle cx="15" cy="6" r="1" fill="currentColor"/><circle cx="19" cy="10" r="0.7" fill="currentColor"/></svg>}
              {t.icon === "bottle" && <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="9" width="8" height="13" rx="2"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/><path d="M10 4h4"/><path d="M9 14h6"/><circle cx="12" cy="17" r="1.5"/></svg>}
              {t.icon === "ruler"  && <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="3" width="4" height="18" rx="1"/><path d="M6 7h2M6 11h2M6 15h2M6 19h2"/><circle cx="16" cy="14" r="3"/><path d="M16 17v4"/></svg>}
              {t.icon === "blocks" && <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/><rect x="8" y="3" width="8" height="8" rx="1"/></svg>}
              {t.icon === "feet"   && <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="8" cy="11" rx="3" ry="4"/><circle cx="5" cy="6" r="1"/><circle cx="8" cy="4.5" r="1"/><circle cx="11" cy="6" r="1"/><ellipse cx="17" cy="15" rx="3" ry="4"/><circle cx="14" cy="10" r="1"/><circle cx="17" cy="8.5" r="1"/><circle cx="20" cy="10" r="1"/></svg>}
            </span>
          </div>
          <div class="p-5 text-center flex-1 flex flex-col">
            <h3 class="font-display font-bold text-[15px] text-[#1E3A5F] mb-2">{t.title}</h3>
            <p class="text-xs text-[#6B7B91] leading-relaxed mb-4 flex-1">{t.desc}</p>
            <span class="inline-flex items-center justify-center gap-1.5 text-xs font-semibold rounded-full px-4 py-2 mx-auto" style={`background:${t.theme.btnBg}; color:${t.theme.btnText};`}>
              Use Tool <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ───────── BROWSE BY CATEGORY ───────── -->
  <section class="max-w-7xl mx-auto px-5 py-10">
    <div class="text-center mb-8">
      <h2 class="font-display text-2xl md:text-3xl text-[#1E3A5F] mb-2">Browse by Category</h2>
      <p class="text-[#6B7B91]">Find the right tool for what you need.</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3">
      {categories.map((c) => (
        <a href={c.href} class="group flex items-center gap-3 bg-white border border-[#E6F0FB] rounded-2xl p-3 hover:shadow-md hover:-translate-y-0.5 transition-all no-underline">
          <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl shrink-0" style={`background:${c.bg}; color:${c.color};`} aria-hidden="true">
            {c.icon === "moon"   && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>}
            {c.icon === "bottle" && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="9" width="8" height="13" rx="2"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>}
            {c.icon === "chart"  && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21v-7m6 7V10m6 11v-5m6 5V4"/></svg>}
            {c.icon === "blocks" && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/><rect x="8" y="3" width="8" height="8" rx="1"/></svg>}
            {c.icon === "feet"   && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="8" cy="11" rx="3" ry="4"/><ellipse cx="17" cy="15" rx="3" ry="4"/></svg>}
            {c.icon === "heart"  && <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9C.8 8.8 2.6 5 6.2 5c2 0 3.4 1.1 4.3 2.5C11.4 6.1 12.8 5 14.8 5c3.6 0 5.4 3.8 3.7 7C19 16.5 12 21 12 21z"/></svg>}
            {c.icon === "stroller" && <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13a7 7 0 0 1 7-7v7H5z"/><path d="M5 13h11v3a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4v-3z"/><circle cx="8" cy="20" r="1.5"/><circle cx="15" cy="20" r="1.5"/></svg>}
          </span>
          <div class="flex-1 min-w-0">
            <div class="font-bold text-sm text-[#1E3A5F] truncate">{c.label}</div>
            <div class="text-xs text-[#6B7B91]">{c.count} tools</div>
          </div>
          <span class="text-[#94A8C2] group-hover:text-[#2E6FB8] transition-colors" aria-hidden="true">›</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ───────── HOW OUR TOOLS WORK ───────── -->
  <section class="px-5 py-12">
    <div class="max-w-7xl mx-auto bg-[#F1F7FD] rounded-3xl py-10 px-6 md:px-10 relative overflow-hidden">
      <div class="text-center mb-10">
        <h2 class="font-display text-2xl md:text-3xl text-[#1E3A5F] flex items-center justify-center gap-2">
          <span class="text-[#5B9BD5]">♡</span> How Our Tools Work <span class="text-[#5B9BD5]">♡</span>
        </h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-4 relative">
        {steps.map((s) => (
          <div class="text-center relative">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full text-white font-bold text-sm mx-auto mb-3" style={`background:${s.color};`}>{s.n}</span>
            <div class="w-20 h-20 mx-auto mb-3 rounded-2xl bg-white flex items-center justify-center" style={`color:${s.color};`} aria-hidden="true">
              {s.icon === "laptop"    && <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="12" rx="2"/><path d="M2 20h20"/><path d="M12 11l1.5 1.5"/></svg>}
              {s.icon === "clipboard" && <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 3h6v3H9z"/><path d="M9 11h6M9 14h6M9 17h4"/></svg>}
              {s.icon === "chart"     && <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 16l3-4 3 3 4-5"/><circle cx="17" cy="10" r="1" fill="currentColor"/></svg>}
              {s.icon === "heart"     && <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9C.8 8.8 2.6 5 6.2 5c2 0 3.4 1.1 4.3 2.5C11.4 6.1 12.8 5 14.8 5c3.6 0 5.4 3.8 3.7 7C19 16.5 12 21 12 21z"/></svg>}
            </div>
            <h3 class="font-bold text-sm text-[#1E3A5F] mb-1">{s.title}</h3>
            <p class="text-xs text-[#6B7B91] leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
      <!-- Decorative plush bunny on the right (placeholder) -->
      <span class="hidden lg:block absolute right-6 top-1/2 -translate-y-1/2 text-6xl opacity-70" aria-hidden="true">🐰</span>
    </div>
  </section>

  <!-- ───────── BOTTOM CTA STRIP ───────── -->
  <section class="max-w-7xl mx-auto px-5 pb-16">
    <div class="bg-[#E6F0FB] rounded-3xl py-6 px-6 md:px-8 flex flex-col md:flex-row items-center gap-5">
      <span class="text-4xl" aria-hidden="true">☁️</span>
      <div class="flex-1 text-center md:text-left">
        <h3 class="font-display font-bold text-[#1E3A5F] text-lg">All our tools are free and always will be.</h3>
        <p class="text-sm text-[#6B7B91]">Created with <span class="text-[#E89BAE]">♥</span> by parents, for parents.</p>
      </div>
      <a href="#popular-tools" class="inline-flex items-center gap-2 bg-[#5B9BD5] hover:bg-[#2E6FB8] text-white text-sm font-semibold px-6 py-3 rounded-full no-underline whitespace-nowrap transition-colors">
        Explore All Tools <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
