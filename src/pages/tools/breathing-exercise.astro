---
import BlogLink from "../../components/BlogLink.astro";
import { publishedSlugs } from "../../lib/published";
import ToolLayout from "../../layouts/ToolLayout.astro";
import AdSenseLazy from "../../components/AdSenseLazy.astro";
import BreathingExercise from "../../components/tools/BreathingExercise.jsx";

const title = "3-Minute Breathing Exercise for Moms: Guided Box Breathing & 4-7-8 — Baby Care Guide";
const description =
  "A guided, visual breathing timer built for the five minutes you actually have: box breathing (4-4-4-4), 4-7-8, or a simple in-4-out-6. Follow the circle, slow your exhale, and reset in under three minutes.";

const faqs = [
  { q: "Which pattern should I pick?", a: "If you're mid-chaos, box breathing (4-4-4-4) is steady and easy to follow. If you're trying to wind down before sleep, 4-7-8 has the longest exhale and hold. If holding your breath feels stressful, or you're nursing or holding a baby, use the simple in-4-out-6 pattern with no holds." },
  { q: "Why does a long exhale help?", a: "Slow breathing with a longer out-breath is one of the most widely used relaxation techniques. It nudges the body away from the fight-or-flight response that stress triggers, which is why your shoulders drop and your jaw loosens after a few rounds, even when nothing about the situation has changed." },
  { q: "How often should I do this?", a: "Once a day as practice, on calm days, so it's familiar when you need it. Then whenever you feel the surge: the toddler meltdown, the 5 p.m. hour, the moment before you respond. The practice is what makes the emergency version work." },
  { q: "I feel dizzy or lightheaded. Is that normal?", a: "Mild lightheadedness can happen if you breathe too deeply or hold too long. Stop, breathe normally, and next time use the no-hold pattern and a smaller breath. If you're pregnant, recently postpartum, or have a breathing or heart condition, check with your provider before using patterns with breath holds." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<ToolLayout
  title={title}
  description={description}
  toolName="Breathing Exercise"
  toolTagline="Box breathing, 4-7-8, or in-4-out-6 — follow the circle for one to five minutes"
  icon="heart"
  theme="purple"
  tipsHeading="Tips"
  tips={[
    { title: "Practice on calm days", desc: "Three minutes a day makes the pause available when the meltdown hits.", icon: "star" },
    { title: "Exhale through the mouth", desc: "Soft and slow, like fogging a mirror. Don't force it.", icon: "leaf" },
    { title: "One earbud, eyes closed", desc: "Pair it with the white noise player if the house is loud.", icon: "moon" },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <h1 class="mb-3">Breathing Exercise for Moms</h1>
  <p class="text-lg text-[#9CA3AF] mb-8 max-w-2xl">
    Pick a pattern and a length, press start, and breathe with the circle. It grows when you breathe in, shrinks when you breathe out, and holds still when you hold.
  </p>

  <BreathingExercise client:load />

  <section class="mt-12 prose-section">
    <h2 class="mb-4">Why this works when "just calm down" doesn't</h2>
    <div class="card space-y-3 leading-relaxed">
      <p>
        Stress is a body state before it's a thought. When a baby cries and a toddler screams at once, your breathing goes shallow, your heart rate climbs, and your jaw clenches without permission. You can't think your way out of that, but you can breathe your way out: slow breathing with a long exhale is one of the best-known relaxation techniques precisely because it works on the body directly, and the mind follows.
      </p>
      <p>
        That's why the pause before you respond to a tantrum is two breaths, not two thoughts. The <BlogLink slug="how-to-stay-calm-with-kids">stay-calm system</BlogLink> on this site is built around that pause, and the <BlogLink slug="mom-rage-why-it-happens-and-what-helps">mom rage</BlogLink> article explains why the long exhale is step one when anger spikes.
      </p>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="mb-4">When to use each pattern</h2>
    <div class="card leading-relaxed">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left border-b border-blue-100">
            <th class="py-2 font-semibold">Pattern</th>
            <th class="py-2 font-semibold">Best for</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-blue-50"><td class="py-2">Box 4-4-4-4</td><td class="py-2">Mid-afternoon overload, before a hard transition, in the car line</td></tr>
          <tr class="border-b border-blue-50"><td class="py-2">4-7-8</td><td class="py-2">Winding down after bedtime, trouble falling asleep when the baby finally does</td></tr>
          <tr><td class="py-2">In 4, out 6</td><td class="py-2">While nursing or holding a baby, if holds feel stressful, during a toddler's meltdown</td></tr>
        </tbody>
      </table>
      <p class="mt-4">
        Your toddler can do a version of this too: the <BlogLink slug="calm-down-activities-for-toddlers-and-moms">calm-down activities</BlogLink> article turns the long exhale into bubble blowing. For the rest of the five-minute toolkit, see <BlogLink slug="5-minute-stress-relief-for-moms">5-minute stress relief for moms</BlogLink>.
      </p>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="mb-4">Frequently asked questions</h2>
    <div class="space-y-3">
      {faqs.map((f) => (
        <details class="card">
          <summary class="font-bold text-[#1E3A5F] cursor-pointer">{f.q}</summary>
          <p class="mt-3 leading-relaxed text-[#374151]">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mt-10">
    <div class="card text-sm text-[#6B7B91]">
      <p class="font-semibold text-[#1E3A5F] mb-2">References</p>
      <ul class="list-disc pl-5 space-y-1">
        <li>National Center for Complementary and Integrative Health. "<a href="https://www.nccih.nih.gov/health/relaxation-techniques-what-you-need-to-know" rel="noopener" target="_blank">Relaxation Techniques: What You Need To Know</a>."</li>
        <li>Mayo Clinic. "<a href="https://www.mayoclinic.org/healthy-lifestyle/stress-management/in-depth/stress-relievers/art-20047257" rel="noopener" target="_blank">Stress relievers: Tips to tame stress</a>."</li>
      </ul>
      <p class="mt-3 italic">This tool is for general wellness and is not medical advice. Stop if you feel dizzy, and check with your provider before using breath holds if you're pregnant or have a heart or lung condition.</p>
    </div>
  </section>

  <div class="mt-8"><AdSenseLazy unit="bottom" /></div>
</ToolLayout>
