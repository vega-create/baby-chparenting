---
import { siteConfig } from "../../site.config";

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 bg-[#FBFCFE]/92 backdrop-blur-md border-b border-[#E6F0FB]">
  <div class="max-w-7xl mx-auto px-5 py-3 flex items-center justify-between gap-4">
    <!-- BRAND -->
    <a href="/" class="flex items-center gap-2 no-underline shrink-0" aria-label={`${siteConfig.name} home`}>
      <span class="brand-mark inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#5B9BD5]/15 text-[#2E6FB8]">
        <!-- Baby face logo placeholder until real PNG is supplied -->
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <circle cx="9" cy="11" r="1" fill="currentColor" />
          <circle cx="15" cy="11" r="1" fill="currentColor" />
          <path d="M9.5 15.5c.7.7 1.6 1 2.5 1s1.8-.3 2.5-1" />
          <path d="M5 7c.5-.7 1.3-1 2-1" />
          <path d="M19 7c-.5-.7-1.3-1-2-1" />
        </svg>
      </span>
      <span class="font-display text-lg sm:text-xl font-bold text-[#2E6FB8]">{siteConfig.name}</span>
    </a>

    <!-- DESKTOP NAV -->
    <nav class="hidden lg:flex items-center gap-7" aria-label="Primary">
      {siteConfig.nav.map((item) => (
        <a
          href={item.href}
          class={`nav-link text-[15px] font-medium no-underline transition-colors pb-1 border-b-2 ${
            isActive(item.href)
              ? "text-[#2E6FB8] border-[#5B9BD5]"
              : "text-[#1E3A5F] border-transparent hover:text-[#2E6FB8]"
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- CTA + SEARCH + MOBILE BTN -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <button type="button" aria-label="Search" class="hidden sm:inline-flex w-9 h-9 items-center justify-center rounded-full text-[#2E6FB8] hover:bg-[#E6F0FB] transition-colors">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <a
        href={siteConfig.parentsCtaUrl}
        class="hidden md:inline-flex items-center gap-1.5 bg-[#5B9BD5] hover:bg-[#2E6FB8] text-white text-sm font-semibold px-5 py-2.5 rounded-full no-underline transition-colors"
      >
        {siteConfig.parentsCtaLabel} <span aria-hidden="true">♡</span>
      </a>
      <button
        id="mobile-menu-btn"
        class="lg:hidden inline-flex items-center justify-center w-9 h-9 text-[#1E3A5F]"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- MOBILE NAV -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-[#E6F0FB] bg-white">
    <ul class="list-none m-0 p-0">
      {siteConfig.nav.map((item) => (
        <li>
          <a
            href={item.href}
            class={`block px-5 py-3 no-underline border-b border-[#E6F0FB] text-[15px] ${
              isActive(item.href) ? "text-[#2E6FB8] font-semibold bg-[#E6F0FB]/40" : "text-[#1E3A5F]"
            }`}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="px-5 py-4">
        <a href={siteConfig.parentsCtaUrl} class="inline-flex items-center gap-1.5 bg-[#5B9BD5] text-white text-sm font-semibold px-5 py-2.5 rounded-full no-underline">
          {siteConfig.parentsCtaLabel} <span aria-hidden="true">♡</span>
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", open ? "false" : "true");
  });
</script>
